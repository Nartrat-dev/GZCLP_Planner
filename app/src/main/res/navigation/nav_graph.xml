<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/WorkoutsFragment">

    <fragment
        android:id="@+id/WorkoutsFragment"
        android:name="com.example.gzclpplanner.WorkoutsFragment"
        android:label="@string/workouts_title"
        tools:layout="@layout/fragment_workouts">

        <action
            android:id="@+id/action_WorkoutsFragment_to_ExercisesFragment"
            app:destination="@id/ExercisesFragment" />
        <action
            android:id="@+id/action_WorkoutsFragment_to_AddWorkoutFragment"
            app:destination="@id/AddWorkoutFragment" />
    </fragment>
    <fragment
        android:id="@+id/ExercisesFragment"
        android:name="com.example.gzclpplanner.ExercisesFragment"
        android:label="@string/exercises_title"
        tools:layout="@layout/fragment_exercises">

        <action
            android:id="@+id/action_ExercisesFragment_to_WorkoutsFragment"
            app:destination="@id/WorkoutsFragment" />
        <argument
            android:name="workoutId"
            app:argType="integer"
            android:defaultValue="-1" />
        <action
            android:id="@+id/action_ExercisesFragment_to_AddExerciseFragment"
            app:destination="@id/AddExerciseFragment" />
    </fragment>
    <fragment
        android:id="@+id/AddWorkoutFragment"
        android:name="com.example.gzclpplanner.AddWorkoutFragment"
        android:label="Add Workout"
        tools:layout="@layout/fragment_add_workout">
        <argument
            android:name="workoutId"
            app:argType="integer"
            android:defaultValue="-1" />
        <argument
            android:name="workoutName"
            app:argType="string"
            android:defaultValue="" />
        <argument
            android:name="workoutNumber"
            app:argType="integer"
            android:defaultValue="1" />
    </fragment>

    <fragment
        android:id="@+id/AddExerciseFragment"
        android:name="com.example.gzclpplanner.AddExerciseFragment"
        android:label="Add Exercise"
        tools:layout="@layout/fragment_add_exercise">
        <argument
            android:name="workoutId"
            app:argType="integer"
            android:defaultValue="1" />
        <argument
            android:name="exerciseId"
            app:argType="integer"
            android:defaultValue="-1" />
        <argument
            android:name="exerciseName"
            app:argType="string"
            android:defaultValue="" />
        <argument
            android:name="startingWeight"
            app:argType="float"
            android:defaultValue="0" />
        <argument
            android:name="tier"
            app:argType="string"
            android:defaultValue="" />
        <argument
            android:name="type"
            app:argType="string"
            android:defaultValue="" />
    </fragment>
</navigation>